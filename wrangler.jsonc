{
  "name": "blog",
  "compatibility_date": "2026-11-04",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}

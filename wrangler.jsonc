// Cloudflare Workers 静态资源部署配置。
// 必须随仓库提交：否则 CI 中的 `npx wrangler deploy` 会进入交互式初始化向导，
// 非交互环境下自动采用默认的 docs/.vitepress/dist；而本项目 VitePress 源目录
// 是仓库根目录（index.md / .vitepress 均在根），真实产物在 ./.vitepress/dist。
{
  "name": "blog",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./.vitepress/dist"
  },
  "observability": {
    "enabled": true
  }
}
